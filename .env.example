# Copy this file to .env.local and fill in the values. Never commit .env.local.

# MongoDB Atlas → your cluster → Connect → Drivers → Node.js
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="accessibility"

# Google AI Studio → Get API key (aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Any current Gemini model your key can use; a "flash" model is fastest/cheapest.
GEMINI_MODEL="gemini-3.6-flash"
